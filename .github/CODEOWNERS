# CODEOWNERS — who must approve a change
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# The ruleset on main and milestone/** requires a code owner's approval, so every
# owned path below cannot be merged without the maintainer. The last matching
# pattern wins.

# Default: the maintainer owns everything.
*                                   @strausmann

# Security-relevant code and configuration (listed explicitly so they stay owned
# even if the default above is ever narrowed).
/backend/app/auth/                  @strausmann
/backend/app/api/                   @strausmann
/backend/app/config.py              @strausmann
/backend/Dockerfile                 @strausmann
/.github/                           @strausmann
/.well-known/                       @strausmann
/SECURITY.md                        @strausmann
/LICENSE                            @strausmann
/licence-policy.yml                 @strausmann
/.releaserc.json                    @strausmann
/commitlint.config.cjs              @strausmann
/scripts/release_impact.py          @strausmann
/scripts/ghcr_rules.py              @strausmann

# Dependency manifests and lockfiles have no code owner: Dependabot patch and
# minor updates are approved and auto-merged by dependabot-auto-merge.yml after
# CI (incl. the licence gate) is green. Major updates are never auto-merged.
# Dependabot updates to workflows (.github/) and to the Dockerfile base image
# stay owned and need the maintainer.
/package.json
/backend/pyproject.toml
/frontend/package.json
/frontend/pnpm-lock.yaml

{
  "name": "label-printer-hub-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm i18n:compile && tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:harness": "playwright test -c playwright.harness.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts && node scripts/check-screenshot-sizes.mjs",
    "gen:api": "python ../backend/scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --strict --typescript"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@scalar/api-reference": "1.77.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/emscripten": "1.41.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "rollup-license-plugin": "3.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11.0.1": "11.0.1",
      "glob@11.1.0": "14.0.4"
    }
  }
}

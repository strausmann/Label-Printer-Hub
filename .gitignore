# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
junit.xml
*.egg-info/
build/
dist/
pip-wheel-metadata/

# Go (if used in frontend)
/bin/
/dist/
*.exe
*.test
*.prof

# Node (Tailwind build, semantic-release)
node_modules/
package-lock.json
package-lock.json.backup
.npm/
.pnpm-store/

# uv lockfile — backend uses pip, uv.lock is a stray artefact from local tooling.
backend/uv.lock

# Tailwind output
app/ui/static/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local dev
.env
.env.local
data/
*.db
*.db-journal
*.log

# Phase 5 persistence
backend/data/
backend/data/hub.db*

# Docker
.dockerignore.local

# Secrets — never commit
*.pem
*.key
*.crt
secrets/
backend/.venv/
# The pinned release toolchain is installed with `npm ci`, so its lockfile is committed.
!.github/release-tools/package-lock.json

# Website (website/): build output, Astro cache, package caches
website/.astro/
website/.npm-cache/
# The OpenAPI document is generated at build time from the backend; it is committed from the
# website's freshness job on (Task 7, second part), when the backend is renamed.
website/openapi/labelyard.json

# Vale (.vale/): the binary and the styles installed by scripts/vale_setup.sh (or `vale sync`);
# the styles we write ourselves (Labelyard, Labelyard-de, config/vocabularies) are committed.
.vale/bin/
.vale/styles/write-good/
.vale/styles/MDX/
.vale/styles/.vale-config/

# Labelyard — example environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets — .env is in .gitignore.
#
# Printers are managed in the web UI (stored in the database); there is no
# printer configuration file and no printer-specific variable.
#
# Variables start with LABELYARD_. The former PRINTER_HUB_ prefix is still read
# as a deprecated fallback (a LABELYARD_ variable wins); the startup log lists
# the names that still need renaming.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Required. Any http(s) URL works, including local ones (http://localhost:8000,
# http://labelyard:8000). For the browser UI use the address you open, e.g.
# https://labelyard.example.com: it decides cookie security and the allowed Origin.
LABELYARD_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Key for secrets stored in the database (AES-256-GCM): base64url of exactly
# 32 random bytes. Required. Generate with:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
LABELYARD_SECRET_KEY=CHANGE_ME

# One-time bootstrap key for creating the first admin. Empty = disabled,
# otherwise at least 32 characters. Generate with: openssl rand -hex 32
LABELYARD_BOOTSTRAP_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Optional (setting a variable here locks the matching field in the UI)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
LABELYARD_DATABASE_URL=sqlite+aiosqlite:////data/printer-hub.db

# Directory with the built web UI served by this process.
LABELYARD_WEB_DIST_DIR=/opt/app/web

# ---------------------------------------------------------------------------
# Webhook authentication
# Minimum 32 characters. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
LABELYARD_WEBHOOK_API_KEY=

# Webhook calls per minute and webhook key (Spoolman and Grocy together); above it: 429.
# LABELYARD_WEBHOOK_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Snipe-IT integration (optional)
# ---------------------------------------------------------------------------
LABELYARD_SNIPEIT_URL=
LABELYARD_SNIPEIT_API_KEY=

# ---------------------------------------------------------------------------
# Grocy integration (optional)
# ---------------------------------------------------------------------------
LABELYARD_GROCY_URL=
LABELYARD_GROCY_API_KEY=

# ---------------------------------------------------------------------------
# Paperless integration (optional)
# ---------------------------------------------------------------------------
LABELYARD_PAPERLESS_URL=
LABELYARD_PAPERLESS_TOKEN=
LABELYARD_PAPERLESS_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# Spoolman integration (no API key required)
# ---------------------------------------------------------------------------
LABELYARD_SPOOLMAN_URL=

# ---------------------------------------------------------------------------
# SSE EventBus — resource limits
#
# LABELYARD_SSE_QUEUE_SIZE      — per-subscriber asyncio.Queue depth.
#                                   Drop-oldest overflow when full. Must be > 0.
# LABELYARD_SSE_HEARTBEAT_S     — keepalive comment interval (seconds) when
#                                   no events flow. Must be > 0.
# LABELYARD_SSE_IDLE_TIMEOUT_S  — seconds of inactivity before the server
#                                   closes the SSE connection. Must be > 0.
# LABELYARD_SSE_MAX_SUBSCRIBERS — max concurrent SSE clients per printer;
#                                   429 is returned when exceeded. Must be > 0.
# LABELYARD_SSE_PROBE_INTERVAL_S — SNMP probe interval for
#                                   StatusProbeProducer (seconds). Must be > 0.
# ---------------------------------------------------------------------------
LABELYARD_SSE_QUEUE_SIZE=32
LABELYARD_SSE_HEARTBEAT_S=30
LABELYARD_SSE_IDLE_TIMEOUT_S=300
LABELYARD_SSE_MAX_SUBSCRIBERS=100
LABELYARD_SSE_PROBE_INTERVAL_S=30

# ---------------------------------------------------------------------------
# Queued tape runs (batches)
# LABELYARD_MAX_QUEUED_RUNS_PER_PRINTER — tape runs one printer has queued or
#                                   printing at once. Over it a batch answers 429
#                                   too-many-queued-runs. At least 5 (the runs a
#                                   printer holds for /continue or a reprint).
# LABELYARD_MAX_QUEUED_RUNS_PER_KEY — tape runs one API key has at once over all
#                                   printers, held runs included. Must be > 0.
# ---------------------------------------------------------------------------
LABELYARD_MAX_QUEUED_RUNS_PER_PRINTER=5
LABELYARD_MAX_QUEUED_RUNS_PER_KEY=20

# ---------------------------------------------------------------------------
# Render time limit
# LABELYARD_RENDER_TIMEOUT_S — seconds one page may take to draw (sheet preview
#                                   page, page job). Past it the preview answers 504
#                                   render-timeout and the page job fails
#                                   render_timeout. The drawing thread cannot be
#                                   stopped: it keeps its render slot until it ends
#                                   (readiness check render_slots). Above 0, at
#                                   most 600.
# ---------------------------------------------------------------------------
LABELYARD_RENDER_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Pangolin-SSO Standard-Header-Authentifizierung
#
# Pangolin injiziert nach erfolgreicher SSO-Authentifizierung folgende Headers:
#   Remote-User         — authentifizierter Benutzername / E-Mail
#   X-Pangolin-Token    — statischer Trust-Token (in Pangolin-Resource konfiguriert)
#
# Das Backend vertraut den Remote-* Headers NUR wenn LABELYARD_SSO_TRUST_TOKEN
# gesetzt ist UND der Header-Wert exakt übereinstimmt.
# Leer lassen = SSO via Remote-User deaktiviert (Standard: deaktiviert).
#
# Konfiguration in Pangolin Resource (Header-Injection):
#   Header-Injection: x-pangolin-token = <gleicher Wert wie SSO_TRUST_TOKEN>
#
# Trust-Token generieren:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
LABELYARD_SSO_USER_HEADER=Remote-User
LABELYARD_SSO_TRUST_HEADER=X-Pangolin-Token
LABELYARD_SSO_TRUST_TOKEN=

# D10: legacy proxy authentication, both off by default. Only the trust token
# above can create a browser session; these two never do.
# Accept the legacy X-Pangolin-User header without a trust token.
LABELYARD_TRUST_LEGACY_PANGOLIN_USER=false
# Accept the Pangolin "Authorization: Basic" bypass (claude-automation).
LABELYARD_TRUST_PANGOLIN_BASIC_BYPASS=false
# Limit the Basic bypass to read scope.
LABELYARD_PANGOLIN_BYPASS_SCOPE_DOWNGRADE=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
LABELYARD_SERVER_PORT=8000
LABELYARD_LOG_LEVEL=INFO

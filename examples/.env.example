# ============================================================================
# Label Printer Hub — example environment file
# Copy to .env and fill in your values. Do NOT commit your .env.
# ============================================================================

# ----- Image version --------------------------------------------------------
# Pin to a specific release for reproducibility, or use "latest" for auto-update.
# One image: ghcr.io/strausmann/label-printer-hub-backend serves API and web UI.
HUB_VERSION=latest

# ----- Internal port and proxy trust (optional) ----------------------------
# Port the hub listens on inside its container (API and web UI share it).
BACKEND_PORT=8000
# Host port for compose.standalone.yml
# HUB_PORT=8000
# uvicorn FORWARDED_ALLOW_IPS — which client IPs may set X-Forwarded-* headers.
# standalone/backend-only default to 127.0.0.1. Never use '*': it lets any client forge X-Forwarded-For.
# The Traefik, Caddy and Pangolin examples take PROXY_IP instead: the fixed address of your reverse proxy
# on the shared network (pin it in the proxy's stack). Exactly one address, no subnet (see #160).
# PROXY_IP=192.0.2.10
# FORWARDED_ALLOW_IPS=127.0.0.1

# ----- Required --------------------------------------------------------------
# Printers are managed in the web UI (stored in the database); no config file.
# Key for secrets stored in the database: base64url of 32 random bytes.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
#       or: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
PRINTER_HUB_SECRET_KEY=CHANGE_ME
# Public base URL of the hub, e.g. https://printerhub.example.com
PRINTER_HUB_PUBLIC_URL=https://printerhub.example.com

# Pangolin variant only (compose.pangolin.yml): shared secret the proxy injects as
# the X-Pangolin-Token header. Generate: openssl rand -hex 32
PRINTER_HUB_SSO_TRUST_TOKEN=CHANGE_ME
# Opt-in legacy paths (off by default):
# PRINTER_HUB_TRUST_LEGACY_PANGOLIN_USER=true
# PRINTER_HUB_TRUST_PANGOLIN_BASIC_BYPASS=true

# ----- Hub (required) -------------------------------------------------------
# Public hostname of the hub (used in Pangolin blueprint labels).
# Only relevant for reverse-proxy variants — for standalone, leave blank.
PRINTERHUB_HOST=printerhub.example.com

# ----- Webhook authentication (required if using webhook endpoint) ----------
# Random 32-byte hex string. Generate: openssl rand -hex 32
PRINTER_HUB_WEBHOOK_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ----- Database -------------------------------------------------------------
# SQLite database path inside the container.
# PRINTER_HUB_DATABASE_URL=sqlite+aiosqlite:////data/printer-hub.db

# ----- App integrations (optional) ------------------------------------------
# Snipe-IT — for asset-tag printing
# PRINTER_HUB_SNIPEIT_URL=https://snipeit.example.com
# PRINTER_HUB_SNIPEIT_API_KEY=

# Grocy — for product/storage labels
# PRINTER_HUB_GROCY_URL=https://grocy.example.com
# PRINTER_HUB_GROCY_API_KEY=

# Spoolman — for 3D printer filament spool labels
# PRINTER_HUB_SPOOLMAN_URL=https://spoolman.example.com

# ----- Logging --------------------------------------------------------------
PRINTER_HUB_LOG_LEVEL=INFO

# ----- Container UID/GID (optional) -----------------------------------------
# Override only if 1000:1000 conflicts with your host user.
# PUID=1000
# PGID=1000

---
/**
 * A screenshot of the web app in the page's language, in the light and the dark theme. The site
 * follows Starlight's theme switch (data-theme on <html>), not only the system setting, so both
 * files are in the page and CSS shows the one of the current theme. The hidden one is not in the
 * accessibility tree, and below the first screen (loading="lazy") the browser does not fetch it.
 *
 * The files are website/src/assets/screens/<shot>.<en|de>.<light|dark>.webp, rendered by
 * `pnpm -C frontend screenshots`; a missing variant fails the build.
 */
import type { ImageMetadata } from "astro";

interface Props {
  shot: string;
  lang: "en" | "de";
  alt: string;
  /** Load at once: only for a picture on the first screen. */
  eager?: boolean;
}

const { shot, lang, alt, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.webp", { eager: true });

function variant(theme: "light" | "dark"): ImageMetadata {
  const file = files[`../assets/screens/${shot}.${lang}.${theme}.webp`];
  if (!file) throw new Error(`missing screenshot ${shot}.${lang}.${theme}.webp in src/assets/screens/`);
  return file.default;
}

const light = variant("light");
const dark = variant("dark");
const loading = eager ? "eager" : "lazy";
---

<span class="ly-shot">
  <img class="ly-shot-light" src={light.src} width={light.width} height={light.height} alt={alt} loading={loading} decoding="async" />
  <img class="ly-shot-dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading={loading} decoding="async" />
</span>
